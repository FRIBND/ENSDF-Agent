{
  "github.copilot.chat.agent.enabled": true,
  "github.copilot.enableRepoSpecificConfig": true,
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.chat.copilotMemory.enabled": true,
  "github.copilot.chat.cli.customAgents.enabled": false,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.notebook.enhancedNextEditSuggestions.enabled": true,
  "github.copilot.chat.responsesApi.toolSearchTool.enabled": true,
  "github.copilot.chat.localIndex.enabled": true,
  "chat.editor.preferCopilotHarness": true,
  "chat.defaultToCopilotHarness": true,
  "chat.copilot.localModel.enabled": true,
  "chat.useAgentSkills": true,
  "chat.useCustomAgentHooks": true,
  "chat.customAgentInSubagent.enabled": true,
  "chat.tips.enabled": false,
  "chat.autopilot.advanced.enabled": true,
  "chat.emptyState.history.enabled": true,
  "chat.restoreLastPanelSession": true,
  "chat.todoListTool.enabled": true,
  "chat.plugins.enabled": true,
  "chat.extensionUnification.enabled": true,
  "chat.tools.confirmationCarousel.enabled": true,
  "chat.tools.compressOutput.enabled": true,
  "chat.useClaudeHooks": true,
  "chat.artifacts.enabled": true,
  "chat.customizations.promptMigration.enabled": true,
  "chat.experimental.stickyScroll.enabled": true,
  "chat.agentHost.codexAgent.enabled": true,
  "chat.editor.codex.preferAgentHost": true,
  "chat.canvases.enabled": true,
  "chat.viewProgressBadge.enabled": true,
  "chat.customizations.marketplace.enabled": true,
  "chat.agentSessions.sessionStorageCleanupSuggestion.enabled": true,
  "chat.agentHost.computerUse.enabled": true,
  "chat.agentHost.moveChats.enabled": true,
  "sessions.chat.unifiedWorkspacePicker.enabled": true,
  "github.copilot.nextEditSuggestions.eagerness": "high",
  "chat.agentSessionsViewLocation": "view",
  "chat.notifyWindowOnConfirmation": "always",
  "chat.notifyWindowOnResponseReceived": "always",
  "chat.tools.terminal.outputLocation": "terminal",
  "chat.viewSessions.orientation": "stacked",
  "chat.persistentProgress": "draw",
  "chat.persistentProgressVerbosity": "compact",
  "chat.defaultModel": "auto",
  "chat.fontSize": 14,
  "chat.agent.maxRequests": 100,
  "extensions.autoUpdateDelay": 3,
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "scminput": false,
    "log": true,
    "python": true
  },
  "chat.agent.visibility": {
    "modernize-azure-dotnet": false,
    "modernize-azure-java": false,
    "modernize-java": false,
    "modernize-java-upgrade": false,
    "vscjava.vscode-java-upgrade/modernize-java": false,
    "vscjava.vscode-java-upgrade.modernize-java": false
  },
  "chat.plugins.marketplaces": [
    "FRIBND/ENSDF-Agent"
  ],
  "files.associations": {
    "*.ens": "log",
    "*.new": "log",
    "*.old": "log",
    "*.adp": "log",
    "*.avg": "log",
    "*.mrg": "log",
    "*.gam": "log",
    "*.lev": "log",
    "*.fed": "log",
    "*.fmt": "log",
    "*.xrf": "log",
    "*.wrn": "log",
    "*.err": "log",
    "*.rpt": "log",
    "*.xundl": "log",
    "*.trans": "log",
    "*.out": "log",
    "*.UPDATED": "log"
  },
  "[log]": {
    "editor.wordWrap": "on",
    "editor.renderWhitespace": "all",
    "editor.guides.indentation": true,
    "editor.rulers": [
      5,
      6,
      7,
      8,
      9,
      19,
      21,
      29,
      31,
      39,
      41,
      49,
      55,
      64,
      74,
      76,
      77,
      80
    ]
  }
}
